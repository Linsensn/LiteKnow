page {
  background-color: #F5F7FA;
}

.container {
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 核心卡片样式复用 */
.content-card {
  width: 100%;
  box-sizing: border-box;
  background: #FFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

/* 输入框样式 */
.text-input {
  width: 100%;
  height: 300rpx;
  background-color: #F9F9F9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 按钮组 */
.action-group {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
}

.upload-btn {
  font-size: 28rpx;
  color: #666;
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx;
  background-color: #F5F7FA;
  border-radius: 30rpx;
}

.generate-btn {
  margin: 0;
  background: #07c160;
  color: #FFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 50rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.generate-btn[disabled] {
  background: #A5E4C0 !important;
  color: #FFF !important;
}

/* 结果区样式 */
.result-card {
  background: #FAFAFC;
  border: 1px solid #EAEAEA;
}

.result-text {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 30rpx;
}

.copy-btn {
  text-align: center;
  font-size: 28rpx;
  color: #07c160;
  padding: 10rpx 0;
  border-top: 1rpx solid #EEEEEE;
  margin-top: 20rpx;
}