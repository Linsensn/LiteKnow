<view class="container">
  
  <view class="session-header" wx:if="{{currentSessionId}}">
    <text class="session-title">摘要会话</text>
    <view class="favorite-btn" bindtap="toggleFavorite">
      <text class="{{isFavorited ? 'fav-icon-active' : 'fav-icon'}}">★</text>
      <text>{{isFavorited ? '已收藏' : '收藏'}}</text>
    </view>
  </view>

  <scroll-view class="chat-scroll-area" scroll-y="true" scroll-into-view="{{scrollToId}}" scroll-with-animation="true">
    <view class="chat-list" wx:if="{{messageList.length > 0}}">
      
      <view class="chat-item {{item.role === 'user' ? 'user-msg' : 'ai-msg'}}" wx:for="{{messageList}}" wx:key="id" id="msg-{{item.id}}">
        <image class="avatar" src="{{item.role === 'user' ? userInfo.avatar_url : '/assets/ai-avatar.png'}}"></image>
        
        <view class="bubble-wrapper">
          <view class="bubble">
            <rich-text wx:if="{{item.role === 'ai' && item.htmlNodes}}" nodes="{{item.htmlNodes}}"></rich-text>
            <text class="content" wx:else>{{item.content}}</text>
          </view>
          
          <view class="copy-btn" wx:if="{{item.role === 'ai' && !isLoading}}" catchtap="copyText" data-text="{{item.content}}">
            <text>📋 复制内容</text>
          </view>
        </view>
      </view>

    </view>
  </scroll-view>

  <view class="bottom-input-area">
    <view class="input-area">
      <textarea 
        class="content-input" 
        placeholder="输入知识点 (如：唐朝历史) 或粘贴长篇课文..." 
        value="{{inputText}}" 
        bindinput="onInput"
        maxlength="-1"
        disable-default-padding="true"
        cursor-spacing="20"
      ></textarea>
      
      <view class="file-list" wx:if="{{uploadedFiles.length > 0}}">
        <view class="file-tag" wx:for="{{uploadedFiles}}" wx:key="id">
          <text class="file-name">📄 {{item.name}}</text>
          <text class="delete-icon" catchtap="removeFile" data-index="{{index}}">×</text>
        </view>
      </view>
    </view>

    <view class="upload-btn-full" bindtap="uploadDoc">
      <text class="icon">+</text> 上传素材(图片/文档)
    </view>

    <view class="btn-wrapper">
      <button class="submit-btn {{(inputText.length > 0 || uploadedFiles.length > 0) ? 'active' : ''}}" bindtap="generateSummary" disabled="{{isLoading}}">
        {{isLoading ? 'AI 提炼中...' : '生成智能摘要'}}
      </button>
    </view>
  </view>

</view>