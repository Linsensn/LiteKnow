/* 新增的独立页面类，重置 display 和 padding */
.detail-page { 
  min-height: 100vh; 
  background-color: #f5f7fa; 
  display: block;
  width: 100%;
}

/* 头部卡片取消上圆角，取消外边距，让它完美贴合顶部并撑满屏幕 */
.header-card { 
  background: #fff; 
  padding: 40rpx 40rpx; 
  border-bottom-left-radius: 40rpx; 
  border-bottom-right-radius: 40rpx; 
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.03); 
  margin-bottom: 40rpx; 
  box-sizing: border-box;
}
.title-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #333; }
.more-btn { font-size: 40rpx; color: #999; line-height: 1; }
.subtitle { font-size: 26rpx; color: #999; margin-bottom: 40rpx; }

.stats-row { display: flex; justify-content: space-around; align-items: center; border-top: 2rpx solid #f0f0f0; padding-top: 40rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.stat-num { font-size: 60rpx; font-weight: 300; }
.percent { font-size: 30rpx; }
.stat-label { font-size: 26rpx; color: #666; margin-top: 10rpx; }
.text-purple { color: #b052d9; }
.text-green { color: #07c160; }

/* 快捷功能区 */
.quick-actions { display: flex; justify-content: space-between; padding: 0 30rpx; margin-bottom: 40rpx; }
.action-card { width: 31%; border-radius: 16rpx; padding: 24rpx 16rpx; position: relative; overflow: hidden; }
.badge { position: absolute; right: 0; top: 0; font-size: 20rpx; color: #fff; padding: 4rpx 12rpx; border-bottom-left-radius: 12rpx; }
.badge.hot { background-color: #ff4d4f; }
.badge.new { background-color: #07c160; }

.action-title { font-size: 30rpx; font-weight: bold; margin-bottom: 8rpx; }
.action-desc { font-size: 20rpx; line-height: 1.4; }

.bg-blue { background-color: #f0f7ff; }
.text-blue { color: #2b85e4; }
.text-blue-light { color: #5cadff; }

.bg-orange { background-color: #fff7e6; }
.text-orange { color: #fa8c16; }
.text-orange-light { color: #ffc069; }

.bg-green { background-color: #f6ffed; }
.text-green-dark { color: #52c41a; }
.text-green-light { color: #95de64; }

/* 练习模式 */
.mode-section { padding: 0 30rpx; }
.section-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30rpx; }
.section-title { font-size: 34rpx; font-weight: bold; color: #333; display: flex; align-items: center; }
.title-line { width: 8rpx; height: 32rpx; background-color: #2b85e4; margin-right: 16rpx; border-radius: 4rpx; }
.setting-btn { font-size: 26rpx; color: #888; }

.mode-grid { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 20rpx; }
.mode-item { width: 48%; background: #fff; border-radius: 16rpx; padding: 30rpx 20rpx; display: flex; justify-content: space-between; align-items: center; box-sizing: border-box; border: 2rpx solid transparent; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02); }
.mode-item:active { background: #f9f9f9; border-color: #e6e6e6; }
.mode-name { font-size: 30rpx; font-weight: 500; color: #333; margin-bottom: 6rpx; }
.mode-progress { font-size: 22rpx; color: #999; }
.mode-icon { font-size: 40rpx; }
.text-red { color: #ff4d4f; }

/* 底部按钮 */
.bottom-spacer { height: 160rpx; }
.footer-bar { position: fixed; bottom: 0; left: 0; width: 100%; padding: 20rpx 40rpx 60rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.05); box-sizing: border-box; z-index: 100; }
.share-btn { width: 100% !important; background-color: #07c160; color: #fff; border-radius: 50rpx; font-size: 36rpx; font-weight: bold; height: 90rpx; display: flex; align-items: center; justify-content: center; }