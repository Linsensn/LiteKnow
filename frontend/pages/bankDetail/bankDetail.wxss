.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 30rpx;
  padding-bottom: 160rpx; /* 给底部悬浮按钮留出空间 */
  box-sizing: border-box;
}

/* 顶部看板 */
.dashboard-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 30rpx;
}

.bank-title {
  font-size: 38rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.bank-meta {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 40rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.percent {
  font-size: 30rpx;
  font-weight: normal;
}

.purple { color: #a272eb; }
.green { color: #07c160; }

.stat-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: #eeeeee;
}

/* 快捷管理区 */
.quick-actions {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}

.action-box {
  width: 31%;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  box-sizing: border-box;
}

.bg-blue { background-color: #eff6ff; }
.bg-orange { background-color: #fff7ed; }
.bg-green { background-color: #f0fdf4; }

.action-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.action-desc {
  font-size: 22rpx;
  color: #888888;
}

.hot-tag {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ff4d4f;
  color: white;
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-weight: bold;
}

/* 练习模式标题 */
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-mark {
  width: 8rpx;
  height: 32rpx;
  background-color: #07c160;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

/* 模式网格 (2列) */
.mode-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.mode-card {
  width: 48%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.mode-card:active {
  border-color: #07c160;
  background-color: #fafafa;
}

.mode-info {
  display: flex;
  flex-direction: column;
}

.mode-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 6rpx;
}

.mode-desc {
  font-size: 24rpx;
  color: #999999;
}

.mode-icon {
  font-size: 40rpx;
}

/* 底部悬浮分享 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #ffffff;
  padding: 20rpx 40rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  z-index: 100;
}

.share-btn {
  background-color: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 50rpx;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100% !important;
}