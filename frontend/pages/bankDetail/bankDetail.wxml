<view class="container">
  <view class="dashboard-card">
    <view class="bank-title">{{bankTitle || '加载中...'}}</view>
    <view class="bank-meta">{{questionCount}}题 · {{createDate}}创建</view>
    
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-value purple">{{completionRate}}<text class="percent">%</text></text>
        <text class="stat-label">完成率</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-value green">{{accuracyRate}}<text class="percent">%</text></text>
        <text class="stat-label">正确率</text>
      </view>
    </view>
  </view>

  <view class="quick-actions">
    <view class="action-box bg-blue">
      <text class="action-title">题库管理</text>
      <text class="action-desc">更多功能看这里</text>
    </view>
    <view class="action-box bg-orange">
      <view class="hot-tag">HOT</view>
      <text class="action-title">练习统计</text>
      <text class="action-desc">追踪学习进度</text>
    </view>
    <view class="action-box bg-green">
      <text class="action-title">我的笔记</text>
      <text class="action-desc">记录心得技巧</text>
    </view>
  </view>

  <view class="section-header">
    <view class="section-mark"></view>
    <text class="section-title">练习模式</text>
  </view>

  <view class="mode-grid">
    <view class="mode-card" bindtap="startPractice" data-mode="顺序练习">
      <view class="mode-info">
        <text class="mode-name">顺序练习</text>
        <text class="mode-desc">1/{{questionCount}}</text>
      </view>
      <text class="mode-icon">📝</text>
    </view>
    
    <view class="mode-card" bindtap="startPractice" data-mode="随机练习">
      <view class="mode-info">
        <text class="mode-name">随机练习</text>
        <text class="mode-desc">随机打乱题目</text>
      </view>
      <text class="mode-icon">🔀</text>
    </view>

    <view class="mode-card" bindtap="startPractice" data-mode="模拟考试">
      <view class="mode-info">
        <text class="mode-name">模拟考试</text>
        <text class="mode-desc">仿真模拟自测</text>
      </view>
      <text class="mode-icon">⏱️</text>
    </view>

    <view class="mode-card" bindtap="startPractice" data-mode="错题练习">
      <view class="mode-info">
        <text class="mode-name">错题练习</text>
        <text class="mode-desc">攻克薄弱环节</text>
      </view>
      <text class="mode-icon">🎯</text>
    </view>

    <!-- 补充：章节练习 -->
    <view class="mode-card" bindtap="startPractice" data-mode="章节练习">
      <view class="mode-info">
        <text class="mode-name">章节练习</text>
        <text class="mode-desc">按章节分类练习</text>
      </view>
      <text class="mode-icon">🗂️</text> <!-- 可以替换为合适的图标 -->
    </view>

    <!-- 补充：题型练习 -->
    <view class="mode-card" bindtap="startPractice" data-mode="题型练习">
      <view class="mode-info">
        <text class="mode-name">题型练习</text>
        <text class="mode-desc">专项突破题型</text>
      </view>
      <text class="mode-icon">📑</text> <!-- 可以替换为合适的图标 -->
    </view>
  </view>

  <view class="bottom-action">
    <button class="share-btn" open-type="share">分 享 题 库</button>
  </view>
</view>