page { 
  background-color: #f7f8fa; 
  display: block; 
  width: 100%;
}

.page-container { 
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 30rpx; 
  padding-bottom: 80rpx; 
}

.form-group { 
  display: block;
  width: 100%;
  box-sizing: border-box;
  background: #fff; 
  padding: 30rpx; 
  border-radius: 16rpx; 
  margin-bottom: 24rpx; 
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02); 
  text-align: left; 
}

.label-title { 
  display: block;
  font-size: 30rpx; 
  color: #333; 
  font-weight: bold; 
  margin-bottom: 20rpx; 
  border-left: 8rpx solid #007aff; 
  padding-left: 16rpx; 
  line-height: 1.2;
}

/* 基础输入框，增加 min-height 保证不塌陷 */
.input-box { 
  display: block;
  width: 100%; 
  box-sizing: border-box; 
  background: #f4f5f7; 
  padding: 24rpx; 
  border-radius: 12rpx; 
  font-size: 28rpx; 
  color: #333; 
  min-height: 88rpx; /* 保证单行也有足够高度 */
}

.tall-input { height: 88rpx; line-height: 88rpx; padding: 0 24rpx; }
.textarea-large { height: 260rpx; line-height: 1.5; padding: 24rpx; }
.textarea-medium { height: 180rpx; line-height: 1.5; padding: 24rpx; }

.option-list { display: flex; flex-direction: column; gap: 20rpx; }

.option-item { 
  display: flex; 
  /* 改为 flex-start 让字母和多行输入框顶部对齐 */
  align-items: flex-start; 
  width: 100%;
  box-sizing: border-box;
}

.opt-label-fixed { 
  width: 70rpx; 
  font-size: 32rpx;
  font-weight: bold; 
  color: #007aff; 
  text-align: left;
  flex-shrink: 0;
  /* 稍微下移一点，与输入框内的文字对齐 */
  padding-top: 24rpx; 
}

.opt-text { flex: 1; line-height: 1.5; }

.picker-box { 
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx; 
  background: #f4f5f7; 
  border-radius: 12rpx; 
  font-size: 28rpx; 
  color: #555; 
}

.text-blue { color: #007aff; font-weight: bold; font-size: 30rpx; margin: 0 10rpx; }

.btn-submit { 
  width: 100% !important;
  background-color: #007aff; 
  color: #fff; 
  border-radius: 44rpx; 
  margin-top: 50rpx; 
  font-size: 32rpx; 
  font-weight: bold;
  height: 90rpx; 
  line-height: 90rpx; 
  padding: 0;
}