/* ✨ 修复 1：解除全局居中，强制撑满 100% 宽度 */
.container {
  display: block; 
  width: 100%;
  box-sizing: border-box;
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 30rpx;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ✨ 修复 2：卡片宽度设为 100%，并增加点击时的原生交互反馈 */
.history-card {
  width: 100%;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03);
  transition: all 0.2s; /* 点击动画过渡 */
}

/* 增加类似 iOS 的点击按压效果 */
.history-card:active {
  transform: scale(0.98);
  background-color: #fafafa;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.task-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #2b85e4;
  background-color: #e6f1fc;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.create-time {
  font-size: 24rpx;
  color: #999999;
}

.card-body {
  margin-bottom: 24rpx;
}

.content-preview {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2; /* 最多显示两行，超出省略号 */
  overflow: hidden;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx dashed #eeeeee;
  padding-top: 24rpx;
}

.status-text { font-size: 26rpx; }
.text-green { color: #07c160; }
.text-gray { color: #999999; }

.action-btn {
  font-size: 26rpx;
  color: #888888;
}

/* 底部加载状态 */
.loading-status {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #aaaaaa;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  margin-bottom: 10rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999999;
}