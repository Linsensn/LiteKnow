.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding-bottom: 40rpx;
}

/* 顶部搜索 */
.header-bar {
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 99;
}
.search-box {
  background-color: #f0f2f5;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 14rpx 24rpx;
}
.search-icon { font-size: 28rpx; margin-right: 16rpx; }
.search-input { flex: 1; font-size: 28rpx; color: #333; }

/* 列表容器 */
.list-container {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 错题卡片 */
.mistake-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx 30rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-content { margin-bottom: 24rpx; }
.question-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.5;
  font-weight: 500;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3; /* 最多显示3行题干 */
  overflow: hidden;
  margin-bottom: 16rpx;
}

.answer-contrast {
  background-color: #f8f9fa;
  padding: 16rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  font-size: 26rpx;
}
.answer-item { margin-bottom: 8rpx; }
.answer-item:last-child { margin-bottom: 0; }
.error { color: #ff4d4f; }
.correct { color: #07c160; }

.card-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.tag {
  font-size: 22rpx;
  color: #ff9800;
  background-color: #fff3e0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.time { font-size: 24rpx; color: #999; }

/* 底部操作栏 */
.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx dashed #eee;
  padding-top: 20rpx;
}
.status-badge {
  font-size: 24rpx;
  color: #ff4d4f;
  background-color: #fff1f0;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.remove-btn {
  margin: 0;
  padding: 10rpx 24rpx;
  font-size: 26rpx;
  color: #07c160;
  background-color: #e8f8f0;
  border-radius: 30rpx;
  line-height: 1.5;
  display: flex;
  align-items: center;
}
.remove-btn::after { border: none; }
.remove-btn:active { opacity: 0.8; }

/* 状态样式 */
.loading-status { text-align: center; padding: 30rpx 0; font-size: 24rpx; color: #aaa; }
.empty-state { display: flex; flex-direction: column; align-items: center; padding-top: 200rpx; }
.empty-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 32rpx; color: #333; margin-bottom: 10rpx; }
.empty-subtext { font-size: 26rpx; color: #999; }