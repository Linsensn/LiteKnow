page {
  background-color: #F5F7FA;
}

.container {
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 空状态样式 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #888;
}

/* 错题卡片样式 */
.content-card {
  width: 100%;
  box-sizing: border-box;
  background: #FFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
  transition: all 0.3s;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 24rpx;
  color: #07c160;
  background-color: #E8F5E9;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.date {
  font-size: 24rpx;
  color: #999;
}

.question-text {
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  font-weight: 500;
}

.expand-hint {
  font-size: 24rpx;
  color: #CCC;
  text-align: center;
  margin-top: 20rpx;
  border-top: 1rpx dashed #EEE;
  padding-top: 20rpx;
}

/* 详情展开区域 */
.detail-area {
  margin-top: 30rpx;
  border-top: 1rpx solid #EEE;
  padding-top: 30rpx;
}

.answer-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.wrong-ans {
  color: #F44336;
}

.correct-ans {
  color: #07c160;
}

.explanation-box {
  background-color: #F8F9FA;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.exp-title {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.exp-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.action-row {
  display: flex;
  justify-content: flex-end;
}

.review-btn {
  margin: 0;
  background: #FFF;
  color: #576B95;
  font-size: 26rpx;
  border: 2rpx solid #576B95;
  border-radius: 30rpx;
  padding: 0 30rpx;
  height: 60rpx;
  line-height: 56rpx;
}