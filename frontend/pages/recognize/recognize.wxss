.container {
  min-height: 100vh;
  background-color: #f5f7fa; 
  padding: 30rpx;
  box-sizing: border-box;
}

/* 核心白色卡片 */
.form-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.form-subtitle {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.5;
  margin-bottom: 40rpx;
}

.input-group {
  margin-bottom: 40rpx;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4d4f;
}

.input-box {
  width: 100%;
  height: 88rpx;
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 文本和附件混合区 */
.content-area {
  background-color: #f7f8fa;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.textarea-box {
  width: 100%;
  height: 280rpx;
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 附件列表样式 */
.file-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: flex-start;
  width: 100%;
  margin-top: 16rpx;
}

.file-tag {
  display: inline-flex;
  align-items: center;
  background-color: #e6f1fc;
  color: #2b85e4;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  max-width: 100%;
}

.file-name {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

.delete-icon {
  margin-left: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #888888;
}

/* 全宽绿色虚线上传按钮 */
.upload-btn-full {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 22rpx 0;
  border: 2rpx dashed #51c471;
  border-radius: 12rpx;
  background-color: #ffffff;
  color: #51c471;
  font-size: 28rpx;
}

.upload-btn-full .icon {
  font-size: 34rpx;
  margin-right: 8rpx;
  font-weight: 400;
  margin-bottom: 4rpx;
}

/* 底部按钮包裹区 */
.btn-wrapper {
  display: flex;
  justify-content: center;
  margin-top: 20rpx;
}

.submit-btn {
  width: 100% !important;
  background-color: #a3e4b7; 
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 16rpx 0;
  transition: all 0.3s;
}

.submit-btn::after {
  border: none;
}

.submit-btn.active {
  background-color: #07c160;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}

.submit-btn.active:active {
  transform: scale(0.98);
  opacity: 0.9;
}