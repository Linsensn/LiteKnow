.container {
  min-height: 100vh;
  background-color: #f5f7fa; 
  padding: 30rpx;
  box-sizing: border-box;
}

/* 核心白色卡片 */
.form-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
}

/* Tabs 样式 */
.tabs {
  display: flex;
  background-color: #f0f2f5;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  padding: 16rpx 0;
  border-radius: 12rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #ffffff;
  color: #333333;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.form-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.form-subtitle {
  font-size: 26rpx;
  color: #888888;
  line-height: 1.5;
  margin-bottom: 30rpx;
}

/* 上传/预览区域 */
.upload-area {
  background-color: #f8f9fa;
  border-radius: 16rpx;
  height: 360rpx;
  width: 100%;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-bottom: 50rpx;
}

.empty-state {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}
.empty-state:active {
  background-color: #f0f2f5; 
}

.plus-icon {
  font-size: 60rpx;
  color: #999999;
  font-weight: 300;
  margin-bottom: 10rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #666666;
}

.preview-state {
  width: 100%;
  height: 100%;
  position: relative;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 20rpx;
  box-sizing: border-box;
}

.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.doc-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}
.doc-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.doc-name {
  font-size: 28rpx;
  color: #333;
  word-break: break-all;
  padding: 0 40rpx;
}

.remove-btn {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  width: 50rpx;
  height: 50rpx;
  background-color: rgba(0, 0, 0, 0.4);
  color: #ffffff;
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  z-index: 10;
}
.remove-btn:active {
  background-color: rgba(0, 0, 0, 0.6);
}

/* 文本输入区样式 */
.text-area-wrapper {
  margin-bottom: 50rpx;
}

.input-group {
  margin-bottom: 30rpx;
}

.label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.required {
  color: #ff4d4f;
}

.input-box {
  width: 100%;
  height: 88rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.textarea-box {
  width: 100%;
  height: 400rpx;
  background-color: #f8f9fa;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 1.5;
}

/* 底部按钮包裹区 */
.btn-wrapper {
  display: flex;
  justify-content: center;
}

.submit-btn {
  width: 80% !important;
  background-color: #a3e4b7; 
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: bold;
  padding: 16rpx 0;
  transition: all 0.3s;
}

.submit-btn::after {
  border: none;
}

.submit-btn.active {
  background-color: #63d58b;
  box-shadow: 0 8rpx 20rpx rgba(99, 213, 139, 0.3);
}

.submit-btn.active:active {
  transform: scale(0.98);
  opacity: 0.9;
}