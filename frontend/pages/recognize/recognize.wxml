<view class="container">
  <view class="form-card">
    
    <view class="form-title">AI 智能题库提取</view>
    <view class="form-subtitle">
      输入题库名称，粘贴长文本或上传图片/PDF文件，AI将自动识别、排版并生成专属题库。
    </view>

    <view class="input-group">
      <text class="label">题库名称 <text class="required">*</text></text>
      <input class="input-box" placeholder="例如：2026大学物理期末题库" value="{{bankName}}" bindinput="onBankNameInput" />
    </view>

    <view class="input-group">
      <text class="label">题目内容或文件 <text class="required">*</text></text>
      
      <view class="content-area">
        <textarea 
          class="textarea-box" 
          placeholder="在此粘贴题目文本，支持选择、判断、问答等混排...或点击下方按钮上传文件。" 
          value="{{rawText}}" 
          bindinput="onTextInput"
          maxlength="-1"
          disable-default-padding="true"
        ></textarea>
        
        <view class="file-list" wx:if="{{uploadedFiles.length > 0}}">
          <view class="file-tag" wx:for="{{uploadedFiles}}" wx:key="id">
            <text class="file-name">📄 {{item.name}}</text>
            <text class="delete-icon" catchtap="removeFile" data-index="{{index}}">×</text>
          </view>
        </view>
      </view>

      <view class="upload-btn-full" bindtap="uploadDoc">
        <text class="icon">+</text> 上传素材(图片/文档)
      </view>
    </view>

    <view class="btn-wrapper">
      <button class="submit-btn {{(bankName && (rawText || uploadedFiles.length > 0)) ? 'active' : ''}}" bindtap="submitRecognize" disabled="{{isUploading}}">
        {{isUploading ? 'AI 提取中...' : '开始生成题库'}}
      </button>
    </view>

  </view>
</view>