page {
  background-color: #F5F7FA;
}

.container {
  padding: 30rpx 24rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.content-card {
  width: 100%;
  box-sizing: border-box;
  background: #FFF;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}

.text-input {
  width: 100%;
  height: 200rpx; /* 相比摘要页面稍微短一点 */
  background-color: #F9F9F9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.action-group {
  display: flex;
  justify-content: flex-end; /* 按钮靠右对齐 */
  margin-top: 30rpx;
}

.generate-btn {
  margin: 0;
  background: #07c160;
  color: #FFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0 60rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.generate-btn[disabled] {
  background: #A5E4C0 !important;
  color: #FFF !important;
}

.result-card {
  background: #FAFAFC;
  border: 1px solid #EAEAEA;
}

.result-text {
  font-size: 30rpx;
  color: #444;
  line-height: 1.8;
  margin-bottom: 30rpx;
}

.action-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 1rpx solid #EEEEEE;
  padding-top: 20rpx;
}

.feedback-btn {
  font-size: 28rpx;
  color: #576B95; /* 微信文字链接经典蓝 */
}

.copy-btn {
  font-size: 28rpx;
  color: #07c160;
  padding: 10rpx 20rpx;
}