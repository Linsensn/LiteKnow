<view class="container">
  <view class="section-card">
    <view class="section-title">提供出题素材</view>
    <textarea class="source-input" placeholder="输入知识点（如：唐朝历史）或粘贴长篇课文..." value="{{sourceText}}" bindinput="onInput"></textarea>
    <view class="upload-btn-light" bindtap="uploadMaterial">
      {{fileName ? '已选择: ' + fileName : '+ 上传素材(图片/文档)'}}
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">测验配置</view>
    
    <view class="config-row">
      <text class="label">生成题数</text>
      <slider class="slider" min="5" max="20" step="5" value="{{questionCount}}" show-value bindchange="onCountChange" activeColor="#07c160"/>
    </view>

    <view class="config-row">
      <text class="label">题目难度</text>
      <view class="radio-group">
        <view class="radio-item {{difficulty === 'easy' ? 'selected' : ''}}" bindtap="setDifficulty" data-level="easy">基础</view>
        <view class="radio-item {{difficulty === 'medium' ? 'selected' : ''}}" bindtap="setDifficulty" data-level="medium">进阶</view>
        <view class="radio-item {{difficulty === 'hard' ? 'selected' : ''}}" bindtap="setDifficulty" data-level="hard">困难</view>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="config-row" style="border:none;">
      <text class="label">保存至题库</text>
      <picker bindchange="onBankChange" range="{{bankList}}" range-key="name">
        <view class="picker-value">{{selectedBankName || '点击选择题库 >'}}</view>
      </picker>
    </view>
  </view>

  <button class="generate-btn {{(sourceText || fileName) && selectedBankId ? 'active' : ''}}" bindtap="generateQuiz" disabled="{{isGenerating}}">
    {{isGenerating ? 'AI 正在出题...' : '一键生成练习'}}
  </button>
</view>