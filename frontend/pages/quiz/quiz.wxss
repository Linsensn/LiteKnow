/* summary.wxss & quiz.wxss 共用基础设计 */
.container { 
  padding: 30rpx; 
  background-color: #f5f7fa; 
  min-height: 100vh; 
  box-sizing: border-box;
}

.form-card, .section-card, .result-card { 
  background: #fff; 
  border-radius: 24rpx; 
  padding: 40rpx 30rpx; 
  margin-bottom: 30rpx; 
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  width: 100%;
  box-sizing: border-box; 
}

.form-title, .section-title { 
  font-size: 34rpx; 
  font-weight: bold; 
  color: #333; 
  margin-bottom: 24rpx;
}

/* 文本域 */
.content-input, .source-input { 
  width: 100%;
  height: 240rpx; 
  min-height: 240rpx;
  background: #f8f9fa; 
  border-radius: 16rpx; 
  padding: 20rpx; 
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box; 
  margin-bottom: 20rpx;
  word-break: break-all;
  overflow-y: auto;
}

/* 按钮通用 */
.submit-btn, .generate-btn { 
  background: #a3e4b7;
  color: #fff; 
  border-radius: 50rpx; 
  font-weight: bold;
  padding: 16rpx 0; 
  width: 100% !important; 
  margin-top: 20rpx;
}

.submit-btn.active, .generate-btn.active { 
  background: #07c160;
  box-shadow: 0 8rpx 20rpx rgba(7,193,96,0.3);
}

/* 摘要页独有 */
.attachment-bar { 
  display: flex; 
  align-items: center; 
  justify-content: flex-end; 
}

.upload-btn, .file-tag { 
  font-size: 24rpx;
  color: #666; 
  background: #f0f2f5; 
  padding: 10rpx 24rpx; 
  border-radius: 30rpx; 
}

.delete-icon { 
  color: #ff4d4f; 
  margin-left: 10rpx; 
  font-weight: bold;
}

.result-header { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 20rpx; 
  border-bottom: 2rpx dashed #eee; 
  padding-bottom: 20rpx;
}

.copy-btn { 
  font-size: 24rpx;
  color: #2b85e4; 
  background: #e6f1fc; 
  padding: 6rpx 20rpx; 
  border-radius: 10rpx;
}

.result-content { 
  font-size: 30rpx; 
  color: #333; 
  line-height: 1.8;
  max-height: 600rpx;
}

/* 测验页独有 */
.upload-btn-light { 
  text-align: center;
  font-size: 26rpx; 
  color: #07c160; 
  padding: 16rpx; 
  border: 2rpx dashed #07c160; 
  border-radius: 12rpx;
}

.config-row { 
  display: flex; 
  align-items: center;
  justify-content: space-between; 
  padding: 20rpx 0; 
  border-bottom: 2rpx solid #f5f5f5;
}

.label { 
  font-size: 30rpx; 
  color: #333;
  font-weight: 500;
}

.slider { 
  flex: 1; 
  margin-left: 40rpx;
}

.radio-group { 
  display: flex; 
  gap: 20rpx;
}

.radio-item { 
  padding: 8rpx 30rpx; 
  background: #f5f5f5; 
  border-radius: 30rpx;
  font-size: 26rpx; 
  color: #666; 
  border: 2rpx solid transparent;
}

.radio-item.selected { 
  background: #e8f8f0; 
  color: #07c160; 
  border-color: #07c160;
}

/* 字体放大，颜色加深 */
.picker-value { 
  font-size: 32rpx; 
  color: #333;
  font-weight: 500;
}

/* 自定义题库名输入框样式 */
.custom-bank-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  min-height: 80rpx;
  background: #f8f9fa;
  padding: 0 30rpx; 
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}