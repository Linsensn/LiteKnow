/* pages/adminUsers/adminUsers.wxss */
page {
  background-color: #f7f8fa;
}

.search-bar {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  gap: 16rpx;
}

.search-input {
  flex: 1;
  background-color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.search-btn {
  background-color: #007aff;
  color: #fff;
  padding: 16rpx 36rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.container {
  padding: 20rpx;
  padding-bottom: 60rpx;
}

.header-bar {
  margin-bottom: 20rpx;
  padding: 0 10rpx;
}

.header-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.total-count {
  font-size: 24rpx;
  color: #666;
  font-weight: normal;
  margin-left: 10rpx;
}

/* 卡片样式 */
.user-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.user-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s;
  width: 100%;
  box-sizing: border-box;
}

.card-disabled {
  background-color: #fafafa;
  opacity: 0.8;
}

.user-info-area {
  display: flex;
  align-items: center;
  flex: 1;
  overflow: hidden;
}

.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.info-content {
  display: flex;
  flex-direction: column;
  justify-content: center;
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sub-info {
  font-size: 24rpx;
}

.text-gray {
  color: #999;
}

/* 标签样式 */
.tag {
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  margin-right: 10rpx;
}

.tag-admin { background-color: #e8f4ff; color: #007aff; }
.tag-student { background-color: #f0f0f0; color: #666; }
.tag-active { background-color: #e3f8e9; color: #34c759; }
.tag-banned { background-color: #ffe8e6; color: #ff3b30; }

/* 按钮操作区 */
.action-area {
  margin-left: 20rpx;
}

.btn-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.action-btn {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: 30rpx;
  text-align: center;
}

.btn-warn { background-color: #fff0d4; color: #ff9500; }
.btn-success { background-color: #e3f8e9; color: #34c759; }
.btn-danger { background-color: #ffe8e6; color: #ff3b30; }

/* 底部提示 */
.loading-tip, .no-more-tip, .empty-tip {
  text-align: center;
  font-size: 24rpx;
  color: #ccc;
  margin-top: 30rpx;
}