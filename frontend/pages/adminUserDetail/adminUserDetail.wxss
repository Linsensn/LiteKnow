/* pages/adminUserDetail/adminUserDetail.wxss */
page {
  background-color: #f7f8fa;
}

/* 强制外层容器满宽并防撑爆 */
.container {
  width: 100%;
  padding: 20rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 顶部画像卡片 */
.user-profile-card {
  width: 100%;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  margin-bottom: 24rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  margin-right: 30rpx;
  flex-shrink: 0;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.name-row {
  display: flex;
  align-items: center;
}

.nickname {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-right: 16rpx;
}

.signature {
  font-size: 26rpx;
  color: #666;
}

.sub-info {
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 标签样式 */
.tag {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-right: 12rpx;
}
.tag-admin { background-color: #e8f4ff; color: #007aff; }
.tag-student { background-color: #f0f0f0; color: #666; }
.tag-active { background-color: #e3f8e9; color: #34c759; }
.tag-banned { background-color: #ffe8e6; color: #ff3b30; }

/* 自定义 Tabs 强制撑满 */
.tabs {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.02);
  justify-content: space-around;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  position: relative;
  white-space: nowrap;
}

.tab-item.active {
  color: #007aff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 30%;
  width: 40%;
  height: 6rpx;
  background-color: #007aff;
  border-radius: 6rpx;
}

/* 内容区面板严格控制宽度 */
.tab-content {
  width: 100%;
  display: block;
}

.content-panel {
  width: 100%;
  box-sizing: border-box;
  background-color: #fff;
  border-radius: 16rpx;
  padding: 30rpx;
  min-height: 400rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
  border-left: 8rpx solid #ff3b30;
  padding-left: 16rpx;
}

.action-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1px solid #f0f0f0;
}

.action-desc {
  display: flex;
  flex-direction: column;
}

.action-desc .title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.action-desc .desc {
  font-size: 22rpx;
  color: #999;
}

.action-btn {
  font-size: 26rpx;
  padding: 12rpx 36rpx;
  border-radius: 40rpx;
  font-weight: bold;
}
.btn-warn { background-color: #fff0d4; color: #ff9500; }
.btn-success { background-color: #e3f8e9; color: #34c759; }

/* 列表项强制满宽 */
.list-item {
  display: flex;
  width: 100%;
  box-sizing: border-box;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1px dashed #f0f0f0;
}

.item-content-left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.item-arrow {
  font-size: 32rpx;
  font-weight: bold;
  padding-left: 20rpx;
}

.item-title { font-size: 28rpx; font-weight: bold; }
.item-desc { font-size: 26rpx; color: #666; }
.item-meta { font-size: 22rpx; }
.text-gray { color: #999; }
.text-blue { color: #007aff; }
.text-purple { color: #5856d6; }

/* 必须撑满的空状态 */
.empty-tip, .loading-tip {
  width: 100%;
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #ccc;
  display: block;
}

/* 详情弹窗样式优化 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.6);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 999;
}

.modal-content {
  width: 90%;
  max-height: 85vh;
  background: #fff;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.25);
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  font-weight: bold;
  font-size: 32rpx;
  background-color: #f8f9fc;
  border-bottom: 1px solid #eee;
  color: #333;
}

.modal-scroll {
  padding: 30rpx;
  height: 60vh; 
  box-sizing: border-box;
  background-color: #fff;
}

.modal-btn {
  padding: 26rpx;
  text-align: center;
  color: #007aff;
  font-weight: bold;
  border-top: 1px solid #eee;
  font-size: 32rpx;
  background-color: #f8f9fc;
}