.edit-page {
  padding: 40rpx 30rpx;
  background-color: #f5f7fa;
  min-height: 100vh;
  box-sizing: border-box;
  display: block; 
  width: 100%;
}

.form-group {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 80rpx;
  width: 100%; 
  box-sizing: border-box;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 0;
}

.divider {
  height: 2rpx;
  background-color: #f0f0f0;
}

.label {
  font-size: 32rpx;
  font-weight: 500;
  color: #333333;
  width: 160rpx; /* 稍微加宽标签宽度 */
}

/* 输入框通用样式 */
.text-input {
  flex: 1;
  text-align: right;
  font-size: 32rpx;
  color: #333333;
}

/* 头像样式 */
.avatar-item { height: 160rpx; }
.avatar-btn { margin: 0; padding: 0; background: transparent; display: flex; align-items: center; justify-content: flex-end; flex: 1; }
.avatar-btn::after { border: none; }
.avatar-preview { width: 110rpx; height: 110rpx; border-radius: 50%; margin-right: 16rpx; background-color: #f0f0f0; }
.arrow { color: #cccccc; font-size: 32rpx; }

/* 保存按钮 */
.save-btn {
  background-color: #07c160;
  color: #ffffff;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: bold;
  padding: 12rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(7, 193, 96, 0.3);
}