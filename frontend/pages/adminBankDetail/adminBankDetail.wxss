page { background-color: #f7f8fa; }
.container { padding: 20rpx; }
.header { font-size: 32rpx; font-weight: bold; margin-bottom: 20rpx; color: #333; }

/* 卡片样式 */
.q-card { background: #fff; padding: 24rpx; border-radius: 16rpx; margin-bottom: 24rpx; box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.03); }
.q-header { display: flex; align-items: center; margin-bottom: 16rpx; }
.checkbox-label { display: flex; align-items: center; }
.q-checkbox { transform: scale(0.8); margin-right: 10rpx; }

/* 标签与排版 */
.tag { font-size: 22rpx; padding: 6rpx 12rpx; border-radius: 8rpx; margin-right: 12rpx; }
.tag-blue { background: #e8f4ff; color: #007aff; }
.tag-gray { background: #f0f0f0; color: #666; }
.q-title { font-size: 30rpx; color: #333; font-weight: bold; margin-bottom: 20rpx; line-height: 1.5; }

/* 选项区域背景 */
.q-options { background: #f9f9f9; padding: 16rpx 20rpx; border-radius: 12rpx; margin-bottom: 20rpx; }
.q-option { font-size: 28rpx; color: #555; line-height: 1.8; }

/* 答案解析 */
.q-answers { font-size: 28rpx; border-top: 2rpx dashed #eee; padding-top: 16rpx; margin-bottom: 20rpx; }
.text-green { color: #34c759; font-weight: bold; margin-left: 8rpx; }
.ai-analysis { margin-top: 10rpx; color: #666; font-size: 26rpx; background: #f0f8ff; padding: 12rpx; border-radius: 8rpx; }

/* 按钮区 */
.action-bar { display: flex; justify-content: space-between; border-top: 2rpx solid #f0f0f0; padding-top: 20rpx; }
.btn-edit, .btn-del { flex: 1; font-size: 28rpx; padding: 12rpx 0; border-radius: 40rpx; margin: 0 10rpx; line-height: 1.5; }
.btn-edit { background: #e8f4ff; color: #007aff; }
.btn-del { background: #ffe8e6; color: #ff3b30; }

/* 底部批量栏 */
.batch-bar { position: fixed; bottom: 0; left: 0; right: 0; background: #fff; padding: 20rpx 30rpx; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); display: flex; justify-content: space-between; align-items: center; box-shadow: 0 -4rpx 10rpx rgba(0,0,0,0.05); z-index: 100; }
.select-all { display: flex; align-items: center; font-size: 28rpx; color: #333; }
.btn-batch-del { background: #ff3b30; color: #fff; border-radius: 40rpx; font-size: 28rpx; padding: 16rpx 40rpx; margin: 0; line-height: 1.5; }
.btn-batch-del[disabled] { background: #ffb4af; color: #fff; }