.container {
  min-height: 100vh;
  background-color: #f7f8fa;
  padding: 30rpx;
  box-sizing: border-box;
}

.list-wrapper {
  width: 100%;
}

/* 列表卡片 */
.bank-item {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 36rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.bank-item:active {
  background-color: #fcfcfc;
}

.item-left {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding-right: 20rpx;
}

.bank-title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.bank-subtitle {
  font-size: 24rpx;
  color: #b2b2b2;
  margin-top: 4rpx;
}

.item-right {
  display: flex;
  align-items: center;
}

.bank-count {
  font-size: 30rpx;
  color: #888888;
  margin-right: 16rpx;
}

.arrow {
  font-size: 30rpx;
  color: #cccccc;
  font-family: "Courier New", Courier, monospace; 
}

/* --- 新增：空状态样式 --- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx; /* 让提示内容居中偏下 */
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #999999;
}