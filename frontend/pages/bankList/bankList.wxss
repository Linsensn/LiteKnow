/* 容器背景设为淡淡的灰色，让白色卡片更凸显 */
.bank-page {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 30rpx;
  display: block; /* 核心修复：摆脱 app.wxss 全局 flex 居中的影响 */
  box-sizing: border-box;
}

/* 搜索框样式 */
.search-box {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.02);
}

.search-input {
  flex: 1;
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.bank-list {
  display: flex;
  flex-direction: column;
}

/* 核心卡片样式：圆角+阴影 */
.bank-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.03); /* 极淡的阴影，高级感来源 */
  transition: all 0.2s;
}

/* 点击反馈效果 */
.bank-card:active {
  transform: scale(0.98);
  background-color: #f9f9f9;
}

/* 字体层级：主标题加粗，副标题灰色 */
.bank-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
}

.bank-right {
  display: flex;
  align-items: center;
}

.q-count {
  font-size: 26rpx;
  color: #999;
  margin-right: 20rpx;
  background: #f0f2f5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.arrow {
  color: #c8c8c8;
  font-size: 28rpx;
  font-weight: bold;
}