.container { 
  display: block; /* 核心：解除全局居中和两端对齐 */
  min-height: 100vh; 
  background-color: #f5f7fa; 
  padding: 30rpx 30rpx 160rpx; 
  box-sizing: border-box; 
}

.progress-bar { margin-bottom: 30rpx; }
.progress-text { font-size: 24rpx; color: #888; margin-bottom: 10rpx; text-align: right; }

.question-card, .analysis-card { 
  width: 100%; 
  box-sizing: border-box;
  background: #fff; 
  border-radius: 20rpx; 
  padding: 40rpx 30rpx; 
  margin-bottom: 30rpx; 
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.03); 
}

.analysis-content {
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 16rpx;
  margin-top: 20rpx;
}

.q-header { margin-bottom: 20rpx; }
.q-type { display: inline-block; background: #e6f1fc; color: #2b85e4; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 8rpx; font-weight: bold; }
.q-content { font-size: 32rpx; color: #333; line-height: 1.6; margin-bottom: 40rpx; font-weight: 500; }

.option-item { display: flex; align-items: center; padding: 24rpx 30rpx; background: #f8f9fa; border-radius: 12rpx; margin-bottom: 20rpx; border: 2rpx solid transparent; transition: all 0.2s; position: relative;}
.opt-prefix { font-weight: bold; margin-right: 20rpx; color: #666; }
.opt-text { flex: 1; font-size: 30rpx; color: #333; }
.result-icon { position: absolute; right: 30rpx; font-size: 32rpx; }

/* 选项状态 */
.option-item.selected { background: #f0f7ff; border-color: #2b85e4; }
.option-item.selected .opt-prefix, .option-item.selected .opt-text { color: #2b85e4; }

.option-item.correct { background: #f6ffed; border-color: #52c41a; }
.option-item.correct .opt-prefix, .option-item.correct .opt-text { color: #52c41a; }

.option-item.wrong { background: #fff1f0; border-color: #ff4d4f; }
.option-item.wrong .opt-prefix, .option-item.wrong .opt-text { color: #ff4d4f; }

.essay-input { width: 100%; height: 200rpx; background: #f8f9fa; padding: 20rpx; border-radius: 12rpx; font-size: 28rpx; box-sizing: border-box;}

/* 解析区 */
.analysis-header { margin-bottom: 20rpx; }
.status-tag { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 8rpx; font-weight: bold; }
.tag-green { background: #f6ffed; color: #52c41a; }
.tag-red { background: #fff1f0; color: #ff4d4f; }

.answer-row { font-size: 28rpx; color: #666; margin-bottom: 30rpx; padding-bottom: 30rpx; border-bottom: 2rpx dashed #eee; }
.text-green { color: #52c41a; font-weight: bold; }
.text-red { color: #ff4d4f; font-weight: bold; }
.ml-20 { margin-left: 40rpx; }

.a-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 16rpx; }
.a-text { font-size: 28rpx; color: #666; line-height: 1.6; }

/* 底部按钮 */
.footer-btn-area { position: fixed; bottom: 0; left: 0; width: 100%; padding: 20rpx 40rpx 60rpx; background: #fff; box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.04); box-sizing: border-box; z-index: 10; }
.action-btn { width: 100% !important; border-radius: 50rpx; font-size: 34rpx; font-weight: bold; height: 90rpx; display: flex; align-items: center; justify-content: center; }
.submit-btn { background: #2b85e4; color: #fff; }
.next-btn { background: #07c160; color: #fff; }
/* 底部双按钮布局 */
.footer-btn-area { display: flex; justify-content: space-between; gap: 30rpx; }
.action-btn { flex: 1; margin: 0 !important; }
.outline-btn { background: #f0f2f5; color: #666; border: none; }
.outline-btn[disabled] { opacity: 0.5; background: #f5f5f5; color: #ccc; }
.finish-btn { background: #ff4d4f; color: #fff; } /* 交卷按钮用醒目的红色 */