page {
  background-color: #f5f7fa;
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  width: 100%;
  padding-top: 0; /* 强制消除顶部间距 */
}

.tabs-wrapper {
  display: flex;
  justify-content: center;
  background-color: #ffffff;
  padding: 30rpx 0;
  width: 100%;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.03);
  position: sticky;
  top: 0;
  z-index: 100;
  /* 确保这里没有 margin-top */
}

.tab {
  font-size: 30rpx;
  color: #888;
  padding: 10rpx 40rpx;
  position: relative;
}

.tab.active {
  color: #2b85e4;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: -30rpx; /* 调整下划线位置 */
  left: 20%;
  width: 60%;
  height: 6rpx;
  background-color: #2b85e4;
  border-radius: 4rpx;
}

.list-wrapper {
  padding: 50rpx 24rpx 40rpx; /* 增加顶部 padding 避免卡片贴着 tab */
  box-sizing: border-box;
  width: 100%;
}

.item-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.05);
  width: 100%;
  box-sizing: border-box;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2c3e50;
  margin-bottom: 32rpx;
}

.item-footer {
  display: flex;
  justify-content: flex-end;
}

.delete-btn {
  margin: 0;
  padding: 0 40rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 24rpx;
  color: #ff6b6b;
  background-color: #fff5f5;
  border-radius: 30rpx;
}
.delete-btn::after { border: none; }